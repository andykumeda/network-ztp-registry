# Copy to .env for hardware-backed lab deployments.
# The included demo path does not require this file.

# Console server API credentials.
OPENGEAR_HOST=192.0.2.20
OPENGEAR_USER=ztp_api_user
OPENGEAR_PASSWORD=change-me
OPENGEAR_SCHEME=https
OPENGEAR_API=/api/v2
OPENGEAR_PORT_IDS=ports-1,ports-2,ports-3,ports-4
OPENGEAR_VERIFY_TLS=true
# OPENGEAR_CA_FILE=/path/to/lab-ca.pem

# ZTP lab network.
DHCP_INTERFACE=eth0
REGISTRY_BIND_IP=127.0.0.1
ZTP_SERVER_IP=192.0.2.10
ZTP_WEB_PORT=8080
DHCP_RANGE_START=192.0.2.100
DHCP_RANGE_END=192.0.2.200
DHCP_ROUTER=192.0.2.1
DHCP_DNS=1.1.1.1,8.8.8.8

# Host paths.
IOS_IMAGES_DIR=/srv/network-ztp/images
ANSIBLE_DIR=/srv/network-ztp/ansible
VAULT_PASS_FILE=/srv/network-ztp/ansible/.vault_pass.txt
ANSIBLE_RUN_ENABLED=false

# Optional ITSM/CMDB webhook sync. Disabled by default.
ITSM_ENABLED=false
ITSM_URL=https://itsm.example.com/api/network-ztp/devices
ITSM_USER=ztp-webhook-user
ITSM_PASS=change-me
ITSM_TIMEOUT=10
ITSM_BATCH_WINDOW=10
